{
  "name": "workbench",
  "version": "3.5.32",
  "description": "工作台 Workbench - 多标签内网客户端",
  "main": "main.js",
  "author": "swlrx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.workbench.app",
    "productName": "workbench",
    "publish": [
      {
        "provider": "github",
        "owner": "swlrx",
        "repo": "workbench"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer-injections.js",
      "update-progress.html",
      "tabbar.html",
      "settings.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/hermes.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "工作台",
      "installerIcon": "hermes.ico",
      "uninstallerIcon": "hermes.ico",
      "artifactName": "workbench-Setup-${version}-win-x64.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
